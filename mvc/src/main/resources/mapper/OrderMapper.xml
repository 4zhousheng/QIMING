<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.zhousheng.mapper.OrderMapper">
    <resultMap id="OrderDetailedVoResultMap" type="com.zhousheng.vo.OrderDetailedVo">
        <!-- 主订单信息 -->
        <id property="orderId" column="order_id"/>
        <result property="totalAmount" column="total_amount"/>
        <result property="createTime" column="create_time"/>
        <collection property="orderItemVoList"
                    ofType="com.zhousheng.vo.OrderItemVo"
                    resultMap="orderItemResultMap"/>
    </resultMap>
    <!-- 订单项独立映射 -->
    <resultMap id="orderItemResultMap" type="com.zhousheng.vo.OrderItemVo">
        <result property="quantity" column="quantity"/>
        <result property="skuId" column="sku_id"/>
        <result property="skuImage" column="sku_images"/>
        <result property="skuPrice" column="sku_price"/>
        <result property="skuTitle" column="sku_title"/>
    </resultMap>
    <!-- SQL查询 -->
    <select id="getOrderDetailedVoWithOrderId" resultMap="OrderDetailedVoResultMap">
        SELECT
            o.id AS order_id,
            o.total_amount,
            o.create_time,
            oi.quantity,
            oi.sku_id,
            oi.sku_price,
            ps.images AS sku_images,
            ps.title AS sku_title
        FROM orders o
                 INNER JOIN order_item oi ON o.id = oi.order_id
                 INNER JOIN product_sku ps ON oi.sku_id = ps.id
        WHERE o.id = #{orderId}
    </select>
</mapper>